{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bango-os.vercel.app/schemas/blueprint-checkpoint-manifest-v1.json",
  "title": "B.O.S. Blueprint Checkpoint Manifest",
  "type": "object",
  "required": ["schema_version", "architecture", "checkpoint", "training_datasets", "commercial_approval", "held_out_benchmarks"],
  "properties": {
    "schema_version": { "const": 1 },
    "architecture": {
      "type": "object",
      "required": ["model", "source_url", "code_revision", "license"]
    },
    "checkpoint": {
      "type": "object",
      "required": ["id", "version", "sha256"]
    },
    "training_datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "manifest_sha256", "license", "contains_customer_data", "commercial_use_status"]
      }
    },
    "commercial_approval": {
      "type": "object",
      "required": ["status", "approved_by", "approved_at"]
    },
    "held_out_benchmarks": {
      "type": "array",
      "contains": { "const": "mitchell-a4-first-floor" }
    }
  },
  "additionalProperties": true
}
