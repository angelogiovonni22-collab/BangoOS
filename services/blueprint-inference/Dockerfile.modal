FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG RASTER2SEQ_COMMIT=a6c4e27a68d11d7a459f6e4a2601fd887227dd1a

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    BOS_RASTER2SEQ_REPO_PATH=/opt/Raster2Seq \
    BOS_RASTER2SEQ_CHECKPOINT=hf:raster2graph-512 \
    BOS_RASTER2SEQ_IMAGE_SIZE=512 \
    BOS_RASTER2SEQ_BRIDGE_COMMAND="python3.10 /opt/bos-blueprint-inference/runtime/raster2seq_bridge.py"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    git \
    libcairo2-dev \
    libgl1 \
    libglib2.0-0 \
    pkg-config \
    python3.10 \
    python3.10-dev \
    python3-pip \
    python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip setuptools wheel ninja packaging
RUN python3.10 -m pip install \
    torch==2.3.1 torchvision==0.18.1 torchaudio==2.3.1 \
    --index-url https://download.pytorch.org/whl/cu118

RUN git clone https://github.com/Cornell-VAILab/Raster2Seq.git /opt/Raster2Seq \
    && cd /opt/Raster2Seq \
    && git checkout "${RASTER2SEQ_COMMIT}" \
    && python3.10 -m pip install -r requirements.txt \
    && cd models/ops \
    && sh make.sh \
    && cd ../../diff_ras \
    && python3.10 setup.py build develop

COPY services/blueprint-inference /opt/bos-blueprint-inference
RUN python3.10 -m pip install /opt/bos-blueprint-inference

WORKDIR /opt/bos-blueprint-inference
