# BangoOS local/runtime configuration example.
# Copy to .env.local for local development and set the equivalent values in Vercel.
# Never commit real keys or secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Stripe subscription billing. Use Sandbox values until the Production go-live gate.
# Keep STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET server-side only.
NEXT_PUBLIC_APP_URL=https://your-bos-domain.com
STRIPE_SECRET_KEY=rk_test_your-restricted-key
STRIPE_WEBHOOK_SECRET=whsec_your-endpoint-signing-secret
STRIPE_PRICE_STARTER_MONTHLY=price_test_starter_monthly
STRIPE_PRICE_STARTER_ANNUAL=price_test_starter_annual
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_test_professional_monthly
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_test_professional_annual
STRIPE_PRICE_BUSINESS_MONTHLY=price_test_business_monthly
STRIPE_PRICE_BUSINESS_ANNUAL=price_test_business_annual
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Production authentication email delivery.
# Trade Partner invitations use Supabase generateLink + direct Resend delivery so the
# secure invite link is not dependent on Supabase SMTP delivery.
RESEND_API_KEY=your-resend-api-key
BOS_AUTH_FROM_EMAIL=Bango Operating System <noreply@your-verified-domain.com>

# Retailer / supplier commerce. Keep all provider credentials server-side.
# Leave capability flags at 0 until the provider has explicitly enabled them for the app.
LOWES_ENVIRONMENT=sandbox
LOWES_CLIENT_ID=
LOWES_CLIENT_SECRET=
LOWES_ACCESS_TOKEN=
LOWES_API_BASE_URL=
LOWES_PRO_ACCOUNT_LINKED=0
LOWES_PRODUCT_CATALOG_ENABLED=0
LOWES_PRICING_ENABLED=0
LOWES_INVENTORY_ENABLED=0
LOWES_ORDERING_ENABLED=0
LOWES_ORDER_STATUS_ENABLED=0

# Orion OpenAI intelligence
OPENAI_API_KEY=your-openai-api-key
ORION_OPENAI_ENABLED=1

# Optional commercial Open-Meteo customer API key. Keep server-side only.
OPEN_METEO_API_KEY=
ORION_REASONING_MODEL=gpt-5.1
ORION_FAST_MODEL=gpt-5-mini
ORION_WEB_SEARCH_ENABLED=1

# Orion v2 natural Realtime voice
ORION_REALTIME_ENABLED=1
ORION_REALTIME_MODEL=gpt-realtime
ORION_REALTIME_VOICE=marin

# Orion background Web Push.
# ORION_VAPID_PUBLIC_KEY is also required in Vercel so the browser can subscribe.
# Keep the private key and dispatch secret server-side only in Supabase Edge Function secrets.
ORION_VAPID_PUBLIC_KEY=your-vapid-public-key
ORION_VAPID_PRIVATE_KEY=your-vapid-private-key
ORION_VAPID_SUBJECT=mailto:notifications@your-domain.com
ORION_PUSH_DISPATCH_SECRET=replace-with-a-long-random-secret

# Orion high-impact action confirmation signing.
# Use a long, random, server-only value in production.
ORION_CONFIRMATION_SECRET=replace-with-a-long-random-secret

# Emergency Realtime microphone automation kill switch.
# Set to 0 to disable Orion voice automation immediately.
NEXT_PUBLIC_ORION_VOICE_AUTOMATION=1
